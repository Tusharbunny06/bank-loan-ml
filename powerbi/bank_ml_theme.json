{
  "name": "Bank ML Theme",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#eda100",
  "bad": "#d03b3b",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 6 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 12 }]
      }
    }
  }
}
